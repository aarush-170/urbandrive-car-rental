# Copy to .env.local and fill in. Never commit real credentials.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=mini_project

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=urbandrive

# Random 32+ byte secret used to sign login session cookies (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=
